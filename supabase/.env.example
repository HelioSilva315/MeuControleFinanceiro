# Segredos das Edge Functions (Supabase injeta SUPABASE_* automaticamente).
# Defina os demais com:  supabase secrets set --env-file supabase/.env
# (NÃO comite o arquivo .env real.)

# --- Stripe (assinatura pela web) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# --- Google Play (assinatura pelo Android/TWA) ---
# Nome do pacote do app publicado na Play Console.
GOOGLE_PACKAGE_NAME=app.nossocaixa
# JSON completo da Service Account (uma linha só, sem quebras).
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
